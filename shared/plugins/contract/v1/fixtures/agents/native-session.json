      "call": "write",
      "session": "agent-1",
      "lines": ["{\"type\":\"user\",\"message\":\"hello\"}"],
      "request": { "method": "lithe/host/agents/write", "params": { "session": "agent-1", "lines": ["{\"type\":\"user\",\"message\":\"hello\"}"] } }
