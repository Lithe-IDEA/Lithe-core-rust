      { "method": "lithe/host/agents/didPrompt", "params": { "session": "agent-3", "turn": 1, "text": "hello" } },
      { "method": "lithe/host/agents/didExit", "params": { "session": "agent-3", "exitCode": 1 } },
      { "method": "lithe/host/agents/didStart", "params": { "session": "agent-4", "agentID": "example", "cwd": "/work/orders" } },
      { "method": "lithe/host/agents/didPrompt", "params": { "session": "agent-4", "turn": 1, "text": "fail" } },
