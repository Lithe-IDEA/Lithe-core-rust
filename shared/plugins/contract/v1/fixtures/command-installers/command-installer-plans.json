{
  "description": "Golden results of plugins.commandInstallers.requirements, plan and defaultDirectory for the plugin file named by plugin; a case that names its own plugin uses that file instead. payload is merged into {\"manifest\": <plugin>}; manifestEdits replace the value at a JSON pointer of the manifest. A case whose result depends on the host's path rules lists platforms.unix and platforms.windows, each with its own payload fields and expected outcome. A rejection is matched by its code and field only.",
  "plugin": "command-installer.plugin.json",
  "cases": [
    {
      "name": "requirements list every systemCommand launch and its installer",
      "operation": "requirements",
      "payload": {},
      "expected": {
        "status": "ok",
        "requirements": {
          "consumers": [
            {
              "kind": "debugAdapter",
              "id": "sample",
              "commands": [{ "command": "sample-dap", "installer": "sample-dap" }]
            },
            {
              "kind": "languageServer",
              "id": "sample",
              "commands": [{ "command": "sample-ls", "installer": "sample-ls" }]
            }
          ],
          "installers": [
            {
              "id": "sample-dap",
              "commands": ["sample-dap"],
              "tool": "builder",
              "minimumVersion": null,
              "download": null,
              "mayUseNetwork": true,
              "targets": ["managed"]
            },
            {
              "id": "sample-ls",
              "commands": ["sample-ls"],
              "tool": "builder",
              "minimumVersion": "1.2",
              "download": null,
              "mayUseNetwork": true,
              "targets": ["managed", "toolDefault"]
            }
          ]
        }
      }
    },
    {
      "name": "a command without an installer is listed with a null installer",
      "operation": "requirements",
      "payload": {},
      "manifestEdits": [
        { "path": "/debugAdapters/0/launch/process/launch/commands", "value": ["sample-dap", "other-dap"] }
      ],
      "expected": {
        "status": "ok",
        "requirements": {
          "consumers": [
            {
              "kind": "debugAdapter",
              "id": "sample",
              "commands": [
                { "command": "sample-dap", "installer": "sample-dap" },
                { "command": "other-dap", "installer": null }
              ]
            },
            {
              "kind": "languageServer",
              "id": "sample",
              "commands": [{ "command": "sample-ls", "installer": "sample-ls" }]
            }
          ],
          "installers": [
            {
              "id": "sample-dap",
              "commands": ["sample-dap"],
              "tool": "builder",
              "minimumVersion": null,
              "download": null,
              "mayUseNetwork": true,
              "targets": ["managed"]
            },
            {
              "id": "sample-ls",
              "commands": ["sample-ls"],
              "tool": "builder",
              "minimumVersion": "1.2",
              "download": null,
              "mayUseNetwork": true,
              "targets": ["managed", "toolDefault"]
            }
          ]
        }
      }
    },
    {
      "name": "a managed plan passes the install directory through the environment",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "managed" },
      "platforms": {
        "unix": {
          "payload": { "installDirectory": "/data/lithe/commands/sample-ls" },
          "expected": {
            "status": "ok",
            "plan": {
              "installer": "sample-ls",
              "target": "managed",
              "commands": ["sample-ls"],
              "tool": "builder",
              "minimumVersion": "1.2",
              "mayUseNetwork": true,
              "timeoutMilliseconds": 300000,
              "download": null,
              "arguments": ["install", "example.org/sample-ls@latest"],
              "environment": { "BUILDER_BIN": "/data/lithe/commands/sample-ls" },
              "commandDirectory": "/data/lithe/commands/sample-ls",
              "directoryProbes": []
            }
          }
        },
        "windows": {
          "payload": { "installDirectory": "C:\\Lithe\\commands\\sample-ls" },
          "expected": {
            "status": "ok",
            "plan": {
              "installer": "sample-ls",
              "target": "managed",
              "commands": ["sample-ls"],
              "tool": "builder",
              "minimumVersion": "1.2",
              "mayUseNetwork": true,
              "timeoutMilliseconds": 300000,
              "download": null,
              "arguments": ["install", "example.org/sample-ls@latest"],
              "environment": { "BUILDER_BIN": "C:\\Lithe\\commands\\sample-ls" },
              "commandDirectory": "C:\\Lithe\\commands\\sample-ls",
              "directoryProbes": []
            }
          }
        }
      }
    },
    {
      "name": "a managed plan replaces the arguments and finds the commands below the directory",
      "operation": "plan",
      "payload": { "installerID": "sample-dap", "target": "managed" },
      "platforms": {
        "unix": {
          "payload": { "installDirectory": "/data/lithe/commands/sample-dap" },
          "expected": {
            "status": "ok",
            "plan": {
              "installer": "sample-dap",
              "target": "managed",
              "commands": ["sample-dap"],
              "tool": "builder",
              "minimumVersion": null,
              "mayUseNetwork": true,
              "timeoutMilliseconds": 600000,
              "download": null,
              "arguments": ["install", "--prefix", "/data/lithe/commands/sample-dap", "example.org/sample-dap@latest"],
              "environment": {},
              "commandDirectory": "/data/lithe/commands/sample-dap/bin",
              "directoryProbes": []
            }
          }
        },
        "windows": {
          "payload": { "installDirectory": "C:\\Lithe\\commands\\sample-dap" },
          "expected": {
            "status": "ok",
            "plan": {
              "installer": "sample-dap",
              "target": "managed",
              "commands": ["sample-dap"],
              "tool": "builder",
              "minimumVersion": null,
              "mayUseNetwork": true,
              "timeoutMilliseconds": 600000,
              "download": null,
              "arguments": ["install", "--prefix", "C:\\Lithe\\commands\\sample-dap", "example.org/sample-dap@latest"],
              "environment": {},
              "commandDirectory": "C:\\Lithe\\commands\\sample-dap\\bin",
              "directoryProbes": []
            }
          }
        }
      }
    },
    {
      "name": "a toolDefault plan lists the directory probes",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "toolDefault" },
      "expected": {
        "status": "ok",
        "plan": {
          "installer": "sample-ls",
          "target": "toolDefault",
          "commands": ["sample-ls"],
          "tool": "builder",
          "minimumVersion": "1.2",
          "mayUseNetwork": true,
          "timeoutMilliseconds": 300000,
          "download": null,
          "arguments": ["install", "example.org/sample-ls@latest"],
          "environment": {},
          "commandDirectory": null,
          "directoryProbes": [
            { "arguments": ["env", "BUILDER_BIN"] },
            { "arguments": ["env", "BUILDER_HOME"] }
          ]
        }
      }
    },
    {
      "name": "an undeclared installer is refused",
      "operation": "plan",
      "payload": { "installerID": "missing", "target": "toolDefault" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.unknown", "field": "installerID" }
    },
    {
      "name": "an undeclared target is refused",
      "operation": "plan",
      "payload": { "installerID": "sample-dap", "target": "toolDefault" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.targetUndeclared", "field": "target" }
    },
    {
      "name": "a managed plan without an install directory is refused",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "managed" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
    },
    {
      "name": "a relative install directory is refused",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "managed", "installDirectory": "commands/sample-ls" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
    },
    {
      "name": "a path of the other platform is not an install directory",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "managed" },
      "platforms": {
        "unix": {
          "payload": { "installDirectory": "C:\\Lithe\\commands\\sample-ls" },
          "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
        },
        "windows": {
          "payload": { "installDirectory": "/data/lithe/commands/sample-ls" },
          "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
        }
      }
    },
    {
      "name": "a toolDefault plan takes no install directory",
      "operation": "plan",
      "payload": { "installerID": "sample-ls", "target": "toolDefault", "installDirectory": "/data/lithe/commands/sample-ls" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
    },
    {
      "name": "the first probe that prints a directory decides",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-ls" },
      "platforms": {
        "unix": {
          "payload": { "outputs": ["/home/me/bin\n", "/home/me/go\n"] },
          "expected": { "status": "ok", "directory": "/home/me/bin" }
        },
        "windows": {
          "payload": { "outputs": ["C:\\Users\\me\\bin\r\n", "C:\\Users\\me\\go\r\n"] },
          "expected": { "status": "ok", "directory": "C:\\Users\\me\\bin" }
        }
      }
    },
    {
      "name": "an empty probe falls through to the first entry of a path list",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-ls" },
      "platforms": {
        "unix": {
          "payload": { "outputs": ["\n", "/home/me/go:/opt/go\n"] },
          "expected": { "status": "ok", "directory": "/home/me/go/bin" }
        },
        "windows": {
          "payload": { "outputs": ["\r\n", "C:\\Users\\me\\go;D:\\go\r\n"] },
          "expected": { "status": "ok", "directory": "C:\\Users\\me\\go\\bin" }
        }
      }
    },
    {
      "name": "no probe naming an absolute directory gives null",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-ls", "outputs": [null, "go\n"] },
      "expected": { "status": "ok", "directory": null }
    },
    {
      "name": "one output is sent for each probe",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-ls", "outputs": ["/home/me/bin\n"] },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.probeOutputsInvalid", "field": "outputs" }
    },
    {
      "name": "an installer without toolDefault has no default directory",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-dap", "outputs": [] },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.targetUndeclared", "field": "installerID" }
    },
    {
      "name": "a download installer is offered on a platform it has an archive for",
      "plugin": "command-installer-download.plugin.json",
      "operation": "requirements",
      "payload": { "platform": { "os": "macos", "arch": "arm64" } },
      "expected": {
        "status": "ok",
        "requirements": {
          "consumers": [
            {
              "kind": "debugAdapter",
              "id": "sample",
              "commands": [{ "command": "sample-lldb", "installer": "sample-lldb" }]
            }
          ],
          "installers": [
            {
              "id": "sample-lldb",
              "commands": ["sample-lldb"],
              "tool": null,
              "minimumVersion": null,
              "download": { "version": "1.2.3" },
              "mayUseNetwork": true,
              "targets": ["managed"]
            }
          ]
        }
      }
    },
    {
      "name": "without a platform every download installer is listed",
      "plugin": "command-installer-download.plugin.json",
      "operation": "requirements",
      "payload": {},
      "expected": {
        "status": "ok",
        "requirements": {
          "consumers": [
            {
              "kind": "debugAdapter",
              "id": "sample",
              "commands": [{ "command": "sample-lldb", "installer": "sample-lldb" }]
            }
          ],
          "installers": [
            {
              "id": "sample-lldb",
              "commands": ["sample-lldb"],
              "tool": null,
              "minimumVersion": null,
              "download": { "version": "1.2.3" },
              "mayUseNetwork": true,
              "targets": ["managed"]
            }
          ]
        }
      }
    },
    {
      "name": "a download installer without an archive for the platform is left out",
      "plugin": "command-installer-download.plugin.json",
      "operation": "requirements",
      "payload": { "platform": { "os": "macos", "arch": "x86_64" } },
      "expected": {
        "status": "ok",
        "requirements": {
          "consumers": [
            {
              "kind": "debugAdapter",
              "id": "sample",
              "commands": [{ "command": "sample-lldb", "installer": null }]
            }
          ],
          "installers": []
        }
      }
    },
    {
      "name": "requirements refuse an unsupported platform",
      "plugin": "command-installer-download.plugin.json",
      "operation": "requirements",
      "payload": { "platform": { "os": "freebsd", "arch": "x86_64" } },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.platformInvalid", "field": "platform" }
    },
    {
      "name": "a download plan names the platform's archive and its mirrors",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed", "platform": { "os": "macos", "arch": "arm64" } },
      "expected": {
        "status": "ok",
        "plan": {
          "installer": "sample-lldb",
          "target": "managed",
          "commands": ["sample-lldb"],
          "tool": null,
          "minimumVersion": null,
          "mayUseNetwork": true,
          "timeoutMilliseconds": 900000,
          "download": {
            "installer": "sample-lldb",
            "version": "1.2.3",
            "os": "macos",
            "arch": "arm64",
            "url": "https://downloads.example.org/sample-lldb/1.2.3/sample-lldb-darwin-arm64.zip",
            "sha256": "2f114a990e1b368dd1dbd33c80c0e719767af2d228391ec0df0571c957f9ac91",
            "archive": "zip",
            "stripPrefix": "",
            "cacheKey": "de1c7271950564f1696dd15c7f23c87e2f8d9afc4311ca55d81c23eccb35250f",
            "commandDirectory": "extension/adapter",
            "mirrors": ["https://mirror.example.net/sample-lldb/1.2.3/sample-lldb-darwin-arm64.zip"]
          },
          "arguments": [],
          "environment": {},
          "commandDirectory": null,
          "directoryProbes": []
        }
      }
    },
    {
      "name": "a download plan carries the archive's strip prefix",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed", "platform": { "os": "linux", "arch": "x86_64" } },
      "expected": {
        "status": "ok",
        "plan": {
          "installer": "sample-lldb",
          "target": "managed",
          "commands": ["sample-lldb"],
          "tool": null,
          "minimumVersion": null,
          "mayUseNetwork": true,
          "timeoutMilliseconds": 900000,
          "download": {
            "installer": "sample-lldb",
            "version": "1.2.3",
            "os": "linux",
            "arch": "x86_64",
            "url": "https://downloads.example.org/sample-lldb/1.2.3/sample-lldb-linux-x64.tar.gz",
            "sha256": "1cd7f386598022b51a5b93b9ffa23e812b23f519cfe1833384ec4bef4bfd1be1",
            "archive": "tar.gz",
            "stripPrefix": "sample-lldb-1.2.3",
            "cacheKey": "0484b60cdc12c632c91122f34138336b89e6b7c26d7f1ada09e232438d406e1e",
            "commandDirectory": "extension/adapter"
          },
          "arguments": [],
          "environment": {},
          "commandDirectory": null,
          "directoryProbes": []
        }
      }
    },
    {
      "name": "a download installer has no toolDefault target",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "toolDefault", "platform": { "os": "macos", "arch": "arm64" } },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.targetUndeclared", "field": "target" }
    },
    {
      "name": "a download plan takes no install directory",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed", "platform": { "os": "macos", "arch": "arm64" }, "installDirectory": "/data/lithe/commands/sample-lldb" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.directoryInvalid", "field": "installDirectory" }
    },
    {
      "name": "a download plan needs the platform",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed" },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.platformInvalid", "field": "platform" }
    },
    {
      "name": "a plan refuses an unsupported platform",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed", "platform": { "os": "freebsd", "arch": "x86_64" } },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.platformInvalid", "field": "platform" }
    },
    {
      "name": "a download plan for a platform without an archive is refused",
      "plugin": "command-installer-download.plugin.json",
      "operation": "plan",
      "payload": { "installerID": "sample-lldb", "target": "managed", "platform": { "os": "macos", "arch": "x86_64" } },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.unavailable", "field": "platform" }
    },
    {
      "name": "a download installer has no default directory",
      "plugin": "command-installer-download.plugin.json",
      "operation": "defaultDirectory",
      "payload": { "installerID": "sample-lldb", "outputs": [] },
      "expected": { "status": "rejected", "code": "plugin.commandInstaller.targetUndeclared", "field": "installerID" }
    }
  ]
}
