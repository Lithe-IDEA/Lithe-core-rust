{
  "schemaVersion": 0,
  "pluginAPIVersion": 0,
  "id": "dev.lithe.test.first-line",
  "displayName": "First-line fixture",
  "version": "1.0.0",
  "requires": { "languages": 1 },
  "vendor": { "id": "org.example", "displayName": "Example", "signatureRequirement": "publisherPackage" },
  "permissions": [],
  "activationEvents": [],
  "languages": [
    {
      "id": "sample",
      "displayName": "Sample",
      "configuration": { "lineComment": "//" },
      "firstLineMatch": "^#![ \\t]*(?:/usr/bin/env[ \\t]+(?:-S[ \\t]+)?|/opt/tools/)sample[0-9]*(?:[ \\t]|$)"
    }
  ]
}
