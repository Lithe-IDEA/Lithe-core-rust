{
  "schemaVersion": 0,
  "id": "dev.lithe.fixture.build-provider-language-server",
  "displayName": "Build Provider With Language Server Fixture",
  "version": "0.1.0",
  "pluginAPIVersion": 0,
  "requires": { "buildProviders": 0, "buildSystems": 0, "languageServers": 0, "languages": 0 },
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": [
    "languageServer.launch",
    "process.build"
  ],
  "activationEvents": [
    "onBuildSystem:mix",
    "onLanguage:elixir"
  ],
  "languages": [
    {
      "id": "elixir",
      "displayName": "Elixir",
      "fileExtensions": ["ex", "exs"],
      "projectFileNames": ["mix.exs"]
    }
  ],
  "languageServers": [
    {
      "languageID": "elixir",
      "launch": { "kind": "systemCommand", "commands": ["elixir-ls"] },
      "arguments": ["--stdio"]
    }
  ],
  "buildSystems": [
    {
      "id": "mix",
      "displayName": "Mix",
      "detection": { "markers": ["mix.exs"], "nesting": "outermost" },
      "invocation": {
        "executables": [{ "kind": "command", "command": "mix" }]
      },
      "provider": {
        "languageServer": "elixir",
        "executesProjectCode": true,
        "mayUseNetwork": false
      },
      "model": { "source": "provider" },
      "tasks": [
        {
          "id": "compile",
          "displayName": "Compile",
          "group": "build",
          "scopes": ["workspace"],
          "arguments": ["compile"]
        },
        {
          "id": "deps-get",
          "displayName": "Fetch Dependencies",
          "group": "other",
          "scopes": ["workspace"],
          "arguments": ["deps.get"]
        }
      ],
      "dependencies": { "source": "provider", "scopes": ["workspace"] },
      "sync": { "watch": ["mix.exs", "mix.lock"] },
      "layout": { "excluded": ["_build", "deps"] }
    }
  ]
}
