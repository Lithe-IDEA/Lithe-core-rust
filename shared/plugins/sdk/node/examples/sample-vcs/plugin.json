{
  "schemaVersion": 0,
  "id": "org.example.sample-vcs",
  "displayName": "Sample VCS",
  "version": "0.1.0",
  "pluginAPIVersion": 0,
  "requires": { "vcsProviders": 0 },
  "requiresTools": ["node"],
  "vendor": {
    "id": "org.example",
    "displayName": "Example",
    "signatureRequirement": "publisherPackage"
  },
  "permissions": ["languageServer.launch", "process.vcs"],
  "activationEvents": ["onVcsRoot:sample"],
  "languages": [],
  "vcsProviders": [
    {
      "id": "sample",
      "displayName": "Sample VCS",
      "detection": {
        "markers": [{ "name": ".samplevcs", "type": "directory" }]
      },
      "metadataPaths": [".samplevcs/revisions.json"],
      "tool": { "commands": ["node"], "validationArguments": ["--version"] },
      "launch": {
        "kind": "runtime",
        "tool": "node",
        "minimumVersion": "20.3",
        "entry": "provider/main.mjs"
      },
      "arguments": ["--stdio"],
      "mayUseNetwork": false
    }
  ]
}
