{
  "schemaVersion": 1,
  "description": "Expected plugins.marketplace.validateIndex outcomes for index.json. `plugins` lists every accepted ID in output order with its availability; `rejected` lists refused entries in index order. `hostCapabilities`, when present, is sent with the request; a request without it offers no capability, so every version on a listed platform is unavailable with plugin.index.apiUnsupported.",
  "cases": [
    {
      "name": "official source on Apple silicon without a host capability table",
      "sourceKind": "official",
      "platform": "darwin-arm64",
      "expected": {
        "plugins": [
          { "id": "dev.lithe.fixture.language-packaged-server", "latestVersion": "1.1.0", "platforms": ["darwin-arm64", "darwin-x64"], "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.elixir-tools", "latestVersion": "3.0.0", "platforms": ["darwin-arm64", "windows-x64"], "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.future-tools", "latestVersion": "3.0.0", "platforms": ["darwin-arm64", "linux-x64"], "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.zig-support", "latestVersion": "2.0.0", "platforms": ["darwin-arm64", "windows-x64"], "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } }
        ],
        "rejected": [
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "third-party source may not list the official namespace",
      "sourceKind": "thirdParty",
      "platform": "darwin-x64",
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "availability": { "status": "unsupported", "code": "plugin.index.platformUnsupported", "platform": "darwin-x64" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.platformUnsupported", "platform": "darwin-x64" } },
          { "id": "io.example.zig-support", "availability": { "status": "unsupported", "code": "plugin.index.platformUnsupported", "platform": "darwin-x64" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "Windows picks its own archive",
      "sourceKind": "thirdParty",
      "platform": "windows-x64",
      "hostCapabilities": { "languages": [0], "languageServers": [0] },
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "availability": { "status": "available", "version": "1.0.0", "sha256": "8888888888888888888888888888888888888888888888888888888888888888" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.platformUnsupported" } },
          { "id": "io.example.zig-support", "availability": { "status": "available", "version": "2.0.0", "sha256": "3333333333333333333333333333333333333333333333333333333333333333" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "host that runs language servers but not build systems",
      "sourceKind": "thirdParty",
      "platform": "darwin-arm64",
      "hostCapabilities": { "languages": [0], "languageServers": [0] },
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "latestVersion": "3.0.0", "availability": { "status": "available", "version": "1.0.0", "pluginAPIVersion": 0, "sha256": "8888888888888888888888888888888888888888888888888888888888888888" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.zig-support", "availability": { "status": "available", "version": "2.0.0" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "host with build systems but no build providers keeps the language-only version",
      "sourceKind": "thirdParty",
      "platform": "darwin-arm64",
      "hostCapabilities": { "buildSystems": [0], "languages": [0], "languageServers": [0] },
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "availability": { "status": "available", "version": "1.0.0" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.zig-support", "availability": { "status": "available", "version": "2.0.0" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "host without language servers is offered no language plugin",
      "sourceKind": "thirdParty",
      "platform": "darwin-arm64",
      "hostCapabilities": { "languages": [0] },
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } },
          { "id": "io.example.zig-support", "availability": { "status": "unsupported", "code": "plugin.index.apiUnsupported" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    },
    {
      "name": "a capability Core cannot validate is never offered",
      "sourceKind": "thirdParty",
      "platform": "windows-x64",
      "hostCapabilities": { "buildProviders": [0], "buildSystems": [0], "debuggers": [0], "languages": [0], "languageServers": [0] },
      "expected": {
        "plugins": [
          { "id": "io.example.elixir-tools", "availability": { "status": "available", "version": "2.0.0", "sha256": "9999999999999999999999999999999999999999999999999999999999999999" } },
          { "id": "io.example.future-tools", "availability": { "status": "unsupported", "code": "plugin.index.platformUnsupported" } },
          { "id": "io.example.zig-support", "availability": { "status": "available", "version": "2.0.0", "sha256": "3333333333333333333333333333333333333333333333333333333333333333" } }
        ],
        "rejected": [
          { "id": "dev.lithe.fixture.language-packaged-server", "code": "plugin.index.officialNamespace" },
          { "id": "io.example.zig-support", "code": "plugin.index.duplicate" }
        ]
      }
    }
  ]
}
