{
  "version": 1,
  "root": "terminal",
  "events": [
    {
      "id": "terminal.input.failed",
      "channel": "terminal",
      "level": "debug",
      "message": "Terminal input operation failed",
      "fields": {
        "stage": {
          "type": "token",
          "required": true,
          "description": "Terminal input action that failed, send or interrupt"
        },
        "error": {
          "type": "error",
          "required": true,
          "description": "Underlying failure at this operation boundary, preserving stable domain and code"
        }
      },
      "rate": 30,
      "owner": "LitheTerminalModule"
    },
    {
      "id": "terminal.session.start_failed",
      "channel": "terminal",
      "level": "warn",
      "message": "Terminal session failed to start",
      "fields": {
        "stage": {
          "type": "token",
          "required": true,
          "description": "Terminal start step that failed, e.g. spawn or attach"
        },
        "error": {
          "type": "error",
          "required": true,
          "description": "Error raised while starting the terminal session, preserving stable domain and code"
        }
      },
      "rate": 60,
      "owner": "Lithe"
    }
  ]
}
