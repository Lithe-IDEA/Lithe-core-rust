{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.dev/contracts/toolchain-global-v1.schema.json",
  "title": "Machine-wide SDK catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tools"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "tools": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "homes"
        ],
        "properties": {
          "homes": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "defaultHome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trustedWorkspaces": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "distrustedWorkspaces": {
      "description": "Workspaces the user chose to keep in safe mode; an explicit decision wins over a trusted location containing it.",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trustedLocations": {
      "description": "Folders whose every workspace, at any depth, is trusted unless distrusted itself. Never a filesystem root.",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
