{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithe.dev/contracts/toolchain-local-v1.schema.json",
  "title": "Lithe Local Toolchains v1",
  "type": "object",
  "required": ["version", "toolchains"],
  "properties": {
    "version": { "const": 1 },
    "toolchains": {
      "description": "Legacy entries written by earlier releases. Core keeps them unchanged and never interprets their keys.",
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 16,
        "additionalProperties": { "type": "string", "maxLength": 4096 }
      }
    },
    "pins": {
      "description": "Workspace-relative directory ('.' for the root) to tool ID to the installation pinned there.",
      "type": "object",
      "maxProperties": 1024,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "additionalProperties": {
          "type": "object",
          "required": ["home", "version", "provider"],
          "properties": {
            "home": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "version": { "type": "string", "maxLength": 128 },
            "provider": { "type": "string", "maxLength": 256 }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
