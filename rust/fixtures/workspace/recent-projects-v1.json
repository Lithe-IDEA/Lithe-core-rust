{
  "version": 1,
  "command": "workspace.recentProjects.reduce",
  "defaultCapacity": 20,
  "cases": [
    {
      "name": "record into an empty list",
      "request": {
        "entries": [],
        "action": { "kind": "record", "path": "/work/alpha", "openedAt": 1000 }
      },
      "expected": {
        "entries": [{ "path": "/work/alpha", "lastOpenedAt": 1000, "pinned": false }],
        "added": ["/work/alpha"],
        "removed": []
      }
    },
    {
      "name": "recording an existing project moves it first and keeps its pin",
      "request": {
        "entries": [
          { "path": "/work/beta", "lastOpenedAt": 3000, "pinned": false },
          { "path": "/work/alpha", "lastOpenedAt": 2000, "pinned": true }
        ],
        "action": { "kind": "record", "path": "/work/beta", "openedAt": 4000 }
      },
      "expected": {
        "entries": [
          { "path": "/work/alpha", "lastOpenedAt": 2000, "pinned": true },
          { "path": "/work/beta", "lastOpenedAt": 4000, "pinned": false }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "capacity evicts the oldest unpinned project and never a pinned one",
      "request": {
        "entries": [
          { "path": "/work/pinned-old", "lastOpenedAt": 10, "pinned": true },
          { "path": "/work/b", "lastOpenedAt": 300, "pinned": false },
          { "path": "/work/a", "lastOpenedAt": 200, "pinned": false }
        ],
        "action": { "kind": "record", "path": "/work/c", "openedAt": 400 },
        "capacity": 2
      },
      "expected": {
        "entries": [
          { "path": "/work/pinned-old", "lastOpenedAt": 10, "pinned": true },
          { "path": "/work/c", "lastOpenedAt": 400, "pinned": false },
          { "path": "/work/b", "lastOpenedAt": 300, "pinned": false }
        ],
        "added": ["/work/c"],
        "removed": ["/work/a"]
      }
    },
    {
      "name": "pinning moves a project into the pinned group; unpinning returns it by time",
      "request": {
        "entries": [
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": false },
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": false }
        ],
        "action": { "kind": "togglePinned", "path": "/work/old" }
      },
      "expected": {
        "entries": [
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": true, "pinOrder": 1 },
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": false }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "pinning an older project puts it before an existing pin",
      "request": {
        "entries": [
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": true, "pinOrder": 4 },
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": false }
        ],
        "action": { "kind": "togglePinned", "path": "/work/old" }
      },
      "expected": {
        "entries": [
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": true, "pinOrder": 5 },
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": true, "pinOrder": 4 }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "repeated pin intent leaves existing pin order alone",
      "request": {
        "entries": [
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": true, "pinOrder": 5 },
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": true, "pinOrder": 4 }
        ],
        "action": { "kind": "setPinned", "path": "/work/old", "pinned": true }
      },
      "expected": {
        "entries": [
          { "path": "/work/new", "lastOpenedAt": 900, "pinned": true, "pinOrder": 5 },
          { "path": "/work/old", "lastOpenedAt": 100, "pinned": true, "pinOrder": 4 }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "reopening a pin preserves its pin order and labels",
      "request": {
        "entries": [
          { "path": "/work/research", "lastOpenedAt": 60, "pinned": true, "pinOrder": 2 },
          { "path": "/work/docs", "lastOpenedAt": 100, "pinned": true, "pinOrder": 1, "tags": ["Docs"] }
        ],
        "action": { "kind": "record", "path": "/work/docs", "openedAt": 200 }
      },
      "expected": {
        "entries": [
          { "path": "/work/research", "lastOpenedAt": 60, "pinned": true, "pinOrder": 2 },
          { "path": "/work/docs", "lastOpenedAt": 200, "pinned": true, "pinOrder": 1, "tags": ["Docs"] }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "setting tags trims and folds duplicates",
      "request": {
        "entries": [{ "path": "/work/alpha", "lastOpenedAt": 100 }],
        "action": { "kind": "setTags", "path": "/work/alpha", "tags": [" Work ", "work", "个人", " "] }
      },
      "expected": {
        "entries": [{ "path": "/work/alpha", "lastOpenedAt": 100, "pinned": false, "tags": ["Work", "个人"] }],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "the same folder on two transports has distinct history entries",
      "request": {
        "entries": [
          { "path": "remote:4:west/repo", "lastOpenedAt": 100, "remote": { "connectionId": "west", "name": "West", "folder": "/repo", "sshConnectionId": "west" } }
        ],
        "action": { "kind": "recordRemote", "openedAt": 200, "remote": { "connectionId": "east", "name": "East", "folder": "/repo", "sshConnectionId": "east" } }
      },
      "expected": {
        "entries": [
          { "path": "remote:4:east/repo", "lastOpenedAt": 200, "pinned": false, "remote": { "connectionId": "east", "name": "East", "folder": "/repo", "sshConnectionId": "east" } },
          { "path": "remote:4:west/repo", "lastOpenedAt": 100, "pinned": false, "remote": { "connectionId": "west", "name": "West", "folder": "/repo", "sshConnectionId": "west" } }
        ],
        "added": ["remote:4:east/repo"],
        "removed": []
      }
    },
    {
      "name": "a stale local open keeps the newer time",
      "request": {
        "entries": [
          { "path": "/work/alpha", "lastOpenedAt": 300 }
        ],
        "action": { "kind": "record", "path": "/work/alpha", "openedAt": 100 }
      },
      "expected": {
        "entries": [{ "path": "/work/alpha", "lastOpenedAt": 300, "pinned": false }],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "a stale remote open keeps the newest reported connection name",
      "request": {
        "entries": [
          { "path": "remote:4:east/repo", "lastOpenedAt": 300, "remote": { "connectionId": "east", "name": "Current name", "folder": "/repo", "sshConnectionId": "east" } }
        ],
        "action": { "kind": "recordRemote", "openedAt": 100, "remote": { "connectionId": "east", "name": "Earlier name", "folder": "/repo", "sshConnectionId": "east" } }
      },
      "expected": {
        "entries": [
          { "path": "remote:4:east/repo", "lastOpenedAt": 300, "pinned": false, "remote": { "connectionId": "east", "name": "Current name", "folder": "/repo", "sshConnectionId": "east" } }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "tag and text filters compose across local and remote projects",
      "request": {
        "entries": [
          { "path": "/work/alpha", "lastOpenedAt": 300, "tags": ["Docs"] },
          { "path": "remote:4:east/repo", "lastOpenedAt": 200, "tags": ["docs", "Remote"], "remote": { "connectionId": "east", "name": "East", "folder": "/repo", "sshConnectionId": "east" } },
          { "path": "/work/east", "lastOpenedAt": 100, "tags": ["Research"] }
        ],
        "action": { "kind": "filter", "query": " EAST ", "tag": "DOCS" }
      },
      "expected": {
        "entries": [],
        "added": [],
        "removed": [],
        "visible": [1],
        "tags": ["Docs", "Remote", "Research"],
        "selectedTag": "Docs"
      }
    },
    {
      "name": "unpinning beyond capacity evicts the oldest unpinned project",
      "request": {
        "entries": [
          { "path": "/work/pinned", "lastOpenedAt": 50, "pinned": true },
          { "path": "/work/recent", "lastOpenedAt": 500, "pinned": false }
        ],
        "action": { "kind": "togglePinned", "path": "/work/pinned" },
        "capacity": 1
      },
      "expected": {
        "entries": [{ "path": "/work/recent", "lastOpenedAt": 500, "pinned": false }],
        "added": [],
        "removed": ["/work/pinned"]
      }
    },
    {
      "name": "toggling an unknown path leaves the list unchanged",
      "request": {
        "entries": [{ "path": "/work/a", "lastOpenedAt": 5, "pinned": false }],
        "action": { "kind": "togglePinned", "path": "/work/missing" }
      },
      "expected": {
        "entries": [{ "path": "/work/a", "lastOpenedAt": 5, "pinned": false }],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "remove drops every listed path, pinned or not",
      "request": {
        "entries": [
          { "path": "/work/a", "lastOpenedAt": 3, "pinned": true },
          { "path": "/work/b", "lastOpenedAt": 2, "pinned": false },
          { "path": "/work/c", "lastOpenedAt": 1, "pinned": false }
        ],
        "action": { "kind": "remove", "paths": ["/work/a", "/work/c", "/work/unknown"] }
      },
      "expected": {
        "entries": [{ "path": "/work/b", "lastOpenedAt": 2, "pinned": false }],
        "added": [],
        "removed": ["/work/a", "/work/c"]
      }
    },
    {
      "name": "import keeps existing projects, skips duplicates, and ranks imports below now in source order",
      "request": {
        "entries": [{ "path": "/work/existing", "lastOpenedAt": 50000, "pinned": false }],
        "action": {
          "kind": "import",
          "paths": ["/work/first", "/work/existing", "/work/second", "/work/first"],
          "openedAt": 40000
        }
      },
      "expected": {
        "entries": [
          { "path": "/work/existing", "lastOpenedAt": 50000, "pinned": false },
          { "path": "/work/first", "lastOpenedAt": 40000, "pinned": false },
          { "path": "/work/second", "lastOpenedAt": 39999, "pinned": false }
        ],
        "added": ["/work/first", "/work/second"],
        "removed": []
      }
    },
    {
      "name": "normalize sorts stored entries, keeps the newest duplicate, and treats a missing time as oldest",
      "request": {
        "entries": [
          { "path": "/work/a", "lastOpenedAt": 10, "pinned": false },
          { "path": "/work/undated", "pinned": false },
          { "path": "/work/b", "lastOpenedAt": 30, "pinned": false },
          { "path": "/work/a", "lastOpenedAt": 40, "pinned": false }
        ],
        "action": { "kind": "normalize" }
      },
      "expected": {
        "entries": [
          { "path": "/work/a", "lastOpenedAt": 40, "pinned": false },
          { "path": "/work/b", "lastOpenedAt": 30, "pinned": false },
          { "path": "/work/undated", "lastOpenedAt": 0, "pinned": false }
        ],
        "added": [],
        "removed": []
      }
    },
    {
      "name": "equal times keep the caller's order",
      "request": {
        "entries": [
          { "path": "/work/z", "lastOpenedAt": 7, "pinned": false },
          { "path": "/work/a", "lastOpenedAt": 7, "pinned": false }
        ],
        "action": { "kind": "normalize" }
      },
      "expected": {
        "entries": [
          { "path": "/work/z", "lastOpenedAt": 7, "pinned": false },
          { "path": "/work/a", "lastOpenedAt": 7, "pinned": false }
        ],
        "added": [],
        "removed": []
      }
    }
  ],
  "invalid": [
    {
      "name": "empty path",
      "request": { "entries": [], "action": { "kind": "record", "path": "", "openedAt": 1 } }
    },
    {
      "name": "zero capacity",
      "request": { "entries": [], "action": { "kind": "normalize" }, "capacity": 0 }
    },
    {
      "name": "negative time",
      "request": { "entries": [], "action": { "kind": "record", "path": "/a", "openedAt": -1 } }
    },
    {
      "name": "unknown action",
      "request": { "entries": [], "action": { "kind": "rename", "path": "/a" } }
    }
  ]
}
