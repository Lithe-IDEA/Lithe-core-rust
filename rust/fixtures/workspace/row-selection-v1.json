{
  "description": "workspace.rowSelection.reduce: one click on rows that show workspace paths, such as the project tree and the changes of a change list. A plain click (choose) selects and drops the marks and the anchor; Cmd or Ctrl (toggle) marks or unmarks and sets the anchor; Shift (extend) marks from the anchor, else the selected row, to the clicked row and keeps other marks; clear ends a batch. The empty path is the workspace root and is never marked. targets is what a batch acts on: the marks without those inside a marked folder. Hosts keep focus, painting and the batch itself.",
  "cases": [
    {
      "name": "a plain click selects its row and drops the marks and the anchor",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "choose",
          "path": "c"
        },
        "selection": {
          "selected": "a",
          "marked": [
            "b",
            "c"
          ],
          "anchor": "b"
        }
      },
      "response": {
        "selection": {
          "selected": "c",
          "marked": []
        },
        "targets": []
      }
    },
    {
      "name": "a plain click on the root selects it",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "choose",
          "path": ""
        },
        "selection": {
          "selected": "a",
          "marked": [
            "b"
          ]
        }
      },
      "response": {
        "selection": {
          "selected": "",
          "marked": []
        },
        "targets": []
      }
    },
    {
      "name": "a Cmd or Ctrl click marks its row and makes it the anchor",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "toggle",
          "path": "b"
        },
        "selection": {
          "selected": "a"
        }
      },
      "response": {
        "selection": {
          "selected": "b",
          "marked": [
            "b"
          ],
          "anchor": "b"
        },
        "targets": [
          "b"
        ]
      }
    },
    {
      "name": "a Cmd or Ctrl click on a marked row unmarks it",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "toggle",
          "path": "b"
        },
        "selection": {
          "selected": "b",
          "marked": [
            "a",
            "b"
          ],
          "anchor": "a"
        }
      },
      "response": {
        "selection": {
          "selected": "b",
          "marked": [
            "a"
          ],
          "anchor": "b"
        },
        "targets": [
          "a"
        ]
      }
    },
    {
      "name": "a Shift click marks from the anchor and keeps the other marks",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "extend",
          "path": "b"
        },
        "selection": {
          "selected": "a",
          "marked": [
            "c"
          ],
          "anchor": "a/x"
        }
      },
      "response": {
        "selection": {
          "selected": "b",
          "marked": [
            "a/x",
            "b",
            "c"
          ],
          "anchor": "a/x"
        },
        "targets": [
          "a/x",
          "b",
          "c"
        ]
      }
    },
    {
      "name": "a Shift click without an anchor marks from the selected row, and a marked folder stands for its contents",
      "request": {
        "rows": [
          "",
          "a",
          "a/x",
          "b",
          "c"
        ],
        "action": {
          "kind": "extend",
          "path": "a"
        },
        "selection": {
          "selected": "b"
        }
      },
      "response": {
        "selection": {
          "selected": "a",
          "marked": [
            "a",
            "a/x",
            "b"
          ]
        },
        "targets": [
          "a",
          "b"
        ]
      }
    },
    {
