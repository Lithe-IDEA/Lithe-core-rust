            "extension": ".kts",
            "language": "kotlin"
          },
          {
            "extension": ".rs",
            "language": "rust"
          },
          {
            "extension": ".txt",
            "language": "plaintext"
          },
          {
            "extension": ".xml",
            "language": "xml"
          }
        ]
      }
    },
    {
      "name": "native package suffix syntax includes C++ and has a sixteen-character bound",
      "payload": {
        "languages": [
          {
            "id": "cpp",
            "highlighted": true,
            "extensions": [
              ".c++",
              ".h++",
              ".abcdefghijklmnop",
              ".abcdefghijklmnopq",
              "._hidden",
              ".+suffix",
              ".Upper",
              ".compound.ext"
            ]
          }
        ]
      },
      "expected": {
        "formats": [
          {
            "extension": ".abcdefghijklmnop",
            "language": "cpp"
          },
          {
            "extension": ".c++",
            "language": "cpp"
          },
          {
            "extension": ".h++",
            "language": "cpp"
          }
        ]
      }
    }
