        "\u001b[91;1mE\u001b[22mr\u001b[39;104mb\u001b[49;3;4mi\u001b[23;24;9ms\u001b[29;7;2mv\u001b[27;22mx\n"
      ],
      "lines": [
        {
          "text": "Erbisvx",
