{
  "version": 1,
  "description": "outputStyle.decode: each case sends its chunks in order, passing back the state each answer returned. lines are all finished lines, oldest first; open is the final state's line.",
  "cases": [
    {
      "name": "maven info line",
      "chunks": [
        "[\u001b[1;34mINFO\u001b[m] Building \u001b[1mlithe\u001b[m\n"
      ],
      "lines": [
        {
          "text": "[INFO] Building lithe",
          "spans": [
            {
              "start": 1,
              "length": 4,
              "style": {
                "foreground": {
                  "index": 4
                },
                "bold": true
              }
            },
            {
              "start": 16,
              "length": 5,
              "style": {
                "bold": true
              }
            }
          ]
        }
      ],
      "open": {
        "text": ""
      }
    },
    {
      "name": "escape split across chunks",
      "chunks": [
        "\u001b[3",
        "2mok\u001b",
        "[0m done\n"
      ],
      "lines": [
        {
          "text": "ok done",
          "spans": [
            {
              "start": 0,
              "length": 2,
              "style": {
                "foreground": {
                  "index": 2
                }
              }
            }
          ]
        }
      ],
      "open": {
        "text": ""
      }
    },
    {
      "name": "extended colours",
      "chunks": [
        "\u001b[38;5;208ma\u001b[48;2;16;32;48mb\u001b[0;38:2::255:0:0mc\u001b[38:5:21md\u001b[m\n"
      ],
      "lines": [
        {
          "text": "abcd",
          "spans": [
            {
              "start": 0,
              "length": 1,
              "style": {
                "foreground": {
                  "index": 208
                }
              }
            },
            {
              "start": 1,
              "length": 1,
              "style": {
                "foreground": {
                  "index": 208
                },
                "background": {
                  "rgb": "#102030"
                }
              }
            },
            {
              "start": 2,
              "length": 1,
              "style": {
                "foreground": {
                  "rgb": "#ff0000"
                }
              }
            },
            {
              "start": 3,
              "length": 1,
