        }
      ],
      "open": {
        "text": "three"
      }
    },
    {
      "name": "carriage return rewrites the line",
      "chunks": [
        "Downloading 10%\r",
        "Downloading 100%\r\n",
        "done"
      ],
      "lines": [
        {
          "text": "Downloading 100%"
        }
      ],
