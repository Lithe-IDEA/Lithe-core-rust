{
  "version": 1,
  "cases": [
    {
      "name": "whole-identifier-rejects-regex",
      "command": "editor.find",
      "document": "foo-barSuffix",
      "payload": {
        "query": "foo(?:-bar)?",
        "regex": true,
        "wholeIdentifier": true
      },
      "errorCode": "invalid_request",
      "errorDetails": "regex_with_whole_identifier"
    },
    {
      "name": "whole-identifier-with-dollar",
      "command": "editor.find",
      "document": "$name $$name $nameSuffix name $name",
      "payload": {
        "query": "$name",
        "caseSensitive": true,
        "wholeIdentifier": true
      },
      "expected": {
        "matches": [{"start": 0, "end": 5}, {"start": 30, "end": 35}],
        "edits": [],
        "selected": 0,
        "truncated": false
      }
    },
    {
      "name": "whole-identifier-with-unicode-continuation",
      "command": "editor.find",
      "document": "foo ℘foo a·b ℘foo a·b b foo",
      "payload": {
        "query": "foo",
        "caseSensitive": true,
        "wholeIdentifier": true
      },
      "expected": {
        "matches": [{"start": 0, "end": 3}, {"start": 30, "end": 33}],
        "edits": [],
        "selected": 0,
        "truncated": false
      }
    },
    {
      "name": "unicode-original-byte-offsets",
      "command": "editor.find",
      "document": "😀 αβ αβ",
      "payload": {
        "query": "αβ"
      },
      "expected": {
        "matches": [
          {
            "start": 5,
            "end": 9
          },
          {
            "start": 10,
            "end": 14
          }
        ],
        "edits": [],
        "selected": 0,
        "truncated": false
      }
    },
    {
      "name": "regex-capture-expansion",
      "command": "editor.find",
      "document": "one two",
      "payload": {
        "query": "(one)",
        "regex": true,
        "replacement": "${1}!"
      },
      "expected": {
        "matches": [
          {
            "start": 0,
            "end": 3
          }
        ],
        "edits": [
          {
            "start": 0,
            "end": 3,
            "text": "one!"
          }
        ],
        "selected": 0,
        "truncated": false
      }
    },
    {
      "name": "preferences-defaults",
      "command": "editor.preferences.resolve",
      "payload": {},
      "expected": {
        "lineNumbers": true,
        "whitespace": false,
        "indentGuides": true,
        "rainbowIndentGuides": false,
        "rainbowIndentGuidesEffective": false,
        "inlayHints": true,
        "cursorStyle": "line",
        "cursorBlink": true,
        "autoSaveDelayMilliseconds": 1500,
        "minimumAutoSaveDelayMilliseconds": 250,
        "maximumAutoSaveDelayMilliseconds": 60000,
        "rainbowBrackets": false,
        "rainbowVariables": false,
        "rainbowLightColors": ["#A4262C", "#0657A4", "#6D3298", "#00695C", "#8A5200", "#394B68"],
        "rainbowDarkColors": ["#FF8A80", "#82B1FF", "#D7A9FF", "#5CE1C4", "#FFBF69", "#A6B8D4"]
      }
    },
    {
      "name": "hidden-indent-guides-preserve-rainbow-choice",
      "command": "editor.preferences.resolve",
      "payload": {
        "indentGuides": false,
        "rainbowIndentGuides": true
      },
      "expected": {
        "lineNumbers": true,
        "whitespace": false,
        "indentGuides": false,
        "rainbowIndentGuides": true,
        "rainbowIndentGuidesEffective": false,
        "inlayHints": true,
        "cursorStyle": "line",
        "cursorBlink": true,
        "autoSaveDelayMilliseconds": 1500,
        "minimumAutoSaveDelayMilliseconds": 250,
        "maximumAutoSaveDelayMilliseconds": 60000,
        "rainbowBrackets": false,
        "rainbowVariables": false,
        "rainbowLightColors": ["#A4262C", "#0657A4", "#6D3298", "#00695C", "#8A5200", "#394B68"],
        "rainbowDarkColors": ["#FF8A80", "#82B1FF", "#D7A9FF", "#5CE1C4", "#FFBF69", "#A6B8D4"]
      }
    },
    {
      "name": "changed-disk-keeps-conflict",
      "command": "editor.recovery.decide",
      "payload": {
        "baseHash": "old",
        "diskHash": "new",
        "bytes": 20
      },
      "expected": {
        "action": "restoreConflict",
        "maxDocumentBytes": 67108864,
        "maxStorageBytes": 268435456,
        "maxDocuments": 64
      }
    },
    {
      "name": "recent-edit-records-position",
      "command": "editor.recent.reduce",
      "payload": {
        "event": {
          "kind": "edited",
          "path": "src/a.txt",
          "name": "a.txt",
          "line": 2,
          "column": 3
        }
      },
      "expected": {
        "entries": [
          {
            "path": "src/a.txt",
            "name": "a.txt",
            "line": 2,
            "column": 3,
            "opened": 1,
            "edited": 1
          }
        ],
        "results": [
          {
            "path": "src/a.txt",
            "name": "a.txt",
            "line": 2,
            "column": 3,
            "opened": 1,
            "edited": 1
          }
        ]
      }
    },
    {
      "name": "migrate-empty-keymap",
      "command": "keymap.schemes.reduce",
      "payload": {
        "state": {}
      },
      "expected": {
        "state": {
          "active": "default",
          "schemes": [
            {
              "id": "default",
              "name": "",
              "bindings": {}
            }
          ]
        },
        "bindings": {}
      }
    },
    {
      "name": "selection-shrinks-with-replacement",
      "command": "editor.find",
      "document": "x alpha alpha y",
      "payload": {
        "query": "alpha",
        "range": {
          "start": 2,
          "end": 13
        },
        "replacement": "a"
      },
      "expected": {
        "matches": [
          {
            "start": 2,
            "end": 7
          },
          {
            "start": 8,
            "end": 13
          }
        ],
        "edits": [
          {
            "start": 2,
            "end": 7,
            "text": "a"
          },
          {
            "start": 8,
            "end": 13,
            "text": "a"
          }
        ],
        "selected": 0,
        "truncated": false,
        "range": {
          "start": 2,
          "end": 5
        }
      }
    }
  ]
}
