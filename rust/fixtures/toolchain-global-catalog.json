{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "missing-global-source-is-read-only",
      "command": "toolchains.catalogState",
      "input": {
        "document": null,
        "platform": "macos"
      },
      "expected": {
        "status": "ok",
        "state": {
          "document": {
            "version": 1,
            "tools": {}
          },
          "storage": {
            "relativePath": "toolchains/global.json",
            "maximumBytes": 262144
          }
        }
      }
    },
    {
      "name": "automatic-without-registrations-creates-no-file",
      "command": "toolchains.editCatalog",
      "input": {
        "document": null,
        "platform": "linux",
        "edits": [
          {
            "tool": "vm",
            "homes": [],
            "defaultHome": null
          }
        ]
      },
      "expected": {
        "status": "ok",
        "edit": {
          "changed": false,
          "document": null,
          "catalog": {
            "version": 1,
            "tools": {}
          }
        }
      }
    },
    {
      "name": "windows-aliases-refused",
      "command": "toolchains.catalogState",
      "input": {
        "document": "{\"version\":1,\"tools\":{\"vm\":{\"homes\":[\"C:/SDK\",\"c:\\\\sdk\"]}}}",
        "platform": "windows"
      },
      "error": "plugin.toolchain.invalidDocument"
    },
    {
      "name": "workspace-trust-grant-normalizes-and-Preserves-tools",
      "command": "toolchains.editCatalog",
      "input": {
        "document": "{\"version\":1,\"tools\":{\"vm\":{\"homes\":[\"C:/SDK/21\"]}}}",
        "platform": "windows",
        "workspaceTrust": {
          "workspace": "C:\\Projects\\Sample\\",
          "trusted": true
        }
      },
      "expected": {
        "status": "ok",
        "edit": {
          "changed": true,
          "document": "{\n  \"version\": 1,\n  \"tools\": {\n    \"vm\": {\n      \"homes\": [\n        \"C:/SDK/21\"\n      ]\n    }\n  },\n  \"trustedWorkspaces\": [\n    \"C:/Projects/Sample\"\n  ]\n}\n",
          "catalog": {
            "version": 1,
            "tools": {
              "vm": {
                "homes": [
                  "C:/SDK/21"
                ]
              }
            },
            "trustedWorkspaces": [
              "C:/Projects/Sample"
            ]
          }
        }
      }
    },
    {
      "name": "workspace-trust-lookup-uses-platform-case-policy",
      "command": "toolchains.catalogState",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedWorkspaces\":[\"C:/Projects/Sample\"]}",
        "platform": "windows",
        "workspaceRoot": "c:\\projects\\sample\\"
      },
      "expected": {
        "status": "ok",
        "state": {
          "document": {
            "version": 1,
            "tools": {},
            "trustedWorkspaces": [
              "C:/Projects/Sample"
            ]
          },
          "storage": {
            "relativePath": "toolchains/global.json",
            "maximumBytes": 262144
          },
          "projectCodeAllowed": true,
          "workspaceTrust": {
            "state": "trusted",
            "location": null,
            "offeredLocation": "c:/projects"
          }
        }
      }
    },
    {
      "name": "workspace-safe-mode-choice-is-recorded",
      "command": "toolchains.editCatalog",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedWorkspaces\":[\"/Users/dev/app\"]}",
        "platform": "macos",
        "workspaceTrust": {
          "workspace": "/Users/dev/app",
          "trusted": false
        }
      },
      "expected": {
        "status": "ok",
        "edit": {
          "changed": true,
          "document": "{\n  \"version\": 1,\n  \"tools\": {},\n  \"distrustedWorkspaces\": [\n    \"/Users/dev/app\"\n  ]\n}\n",
          "catalog": {
            "version": 1,
            "tools": {},
            "distrustedWorkspaces": [
              "/Users/dev/app"
            ]
          }
        }
      }
    },
    {
      "name": "workspace-trusted-location-covers-nested-workspaces",
      "command": "toolchains.catalogState",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedLocations\":[\"/Users/dev/code\"]}",
        "platform": "macos",
        "workspaceRoot": "/Users/dev/code/libs/util"
      },
      "expected": {
        "status": "ok",
        "state": {
          "document": {
            "version": 1,
            "tools": {},
            "trustedLocations": [
              "/Users/dev/code"
            ]
          },
          "storage": {
            "relativePath": "toolchains/global.json",
            "maximumBytes": 262144
          },
          "projectCodeAllowed": true,
          "workspaceTrust": {
            "state": "trusted",
            "location": "/Users/dev/code",
            "offeredLocation": "/Users/dev/code/libs"
          }
        }
      }
    },
    {
      "name": "trusted-location-added-and-absent-one-removed-without-a-workspace",
      "command": "toolchains.editCatalog",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedWorkspaces\":[\"/Users/dev/app\"]}",
        "platform": "macos",
        "trustedLocations": {
          "add": [
            "/Users/dev/code/"
          ],
          "remove": [
            "/Users/dev/old"
          ]
        }
      },
      "expected": {
        "status": "ok",
        "edit": {
          "changed": true,
          "document": "{\n  \"version\": 1,\n  \"tools\": {},\n  \"trustedWorkspaces\": [\n    \"/Users/dev/app\"\n  ],\n  \"trustedLocations\": [\n    \"/Users/dev/code\"\n  ]\n}\n",
          "catalog": {
            "version": 1,
            "tools": {},
            "trustedWorkspaces": [
              "/Users/dev/app"
            ],
            "trustedLocations": [
              "/Users/dev/code"
            ]
          }
        }
      }
    },
    {
      "name": "trusted-location-removed-by-platform-identity",
      "command": "toolchains.editCatalog",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedLocations\":[\"C:/Code\",\"D:/Work\"]}",
        "platform": "windows",
        "trustedLocations": {
          "remove": [
            "c:\\code\\"
          ]
        }
      },
      "expected": {
        "status": "ok",
        "edit": {
          "changed": true,
          "document": "{\n  \"version\": 1,\n  \"tools\": {},\n  \"trustedLocations\": [\n    \"D:/Work\"\n  ]\n}\n",
          "catalog": {
            "version": 1,
            "tools": {},
            "trustedLocations": [
              "D:/Work"
            ]
          }
        }
      }
    },
    {
      "name": "trusted-location-filesystem-root-refused",
      "command": "toolchains.editCatalog",
      "input": {
        "document": null,
        "platform": "windows",
        "trustedLocations": {
          "add": [
            "D:\\"
          ]
        }
      },
      "error": "plugin.toolchain.rootLocation"
    },
    {
      "name": "hand-written-root-location-refused",
      "command": "toolchains.catalogState",
      "input": {
        "document": "{\"version\":1,\"tools\":{},\"trustedLocations\":[\"/\"]}",
        "platform": "macos",
        "workspaceRoot": "/Users/dev/app"
      },
      "error": "plugin.toolchain.invalidDocument"
    }
  ]
}
